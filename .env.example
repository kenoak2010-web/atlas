# ATLAS – server-side configuration. Copy to .env.local (local) or set in your host's
# environment settings (e.g. Vercel → Project → Settings → Environment Variables).
# All keys are free and optional; without one, that single source shows "not configured"
# and everything else keeps working. Keys are only read on the server, never sent to the browser.

# NASA FIRMS active fires (VIIRS NOAA-20 NRT). Free: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# ReliefWeb API v2 requires an approved appname. Request: https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APPNAME=

# YouTube Data API v3 key (Google Cloud console, free quota 10,000 units/day).
# Lets ATLAS embed each broadcaster's current live video. Without it the
# channel-based live embed and official links are used.
YOUTUBE_API_KEY=

# OpenSky Network API client (OAuth2 client credentials) for higher aircraft rate limits.
# https://opensky-network.org/my-opensky/account
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# CoinGecko demo API key (optional, raises rate limits). https://www.coingecko.com/en/api
COINGECKO_DEMO_KEY=

# User-Agent sent to upstream APIs. Several providers (NWS, Nominatim-style services)
# ask for contact details. Example: "ATLAS/1.0 (you@example.com)"
ATLAS_USER_AGENT=
